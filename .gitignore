# Python build/runtime output
__pycache__/
*.pyc
.venv/

# PyKotor auto-logs (rotate on every run; ~400k lines of diff churn)
*pykotor.log*
/logs/
/scripts/logs/

# Local caches, scratch backups, compiled test binaries
.doc_search_cache.db
kdb_backup_*.db
*_test_bin

# Kept on purpose (evidence / fixtures), do NOT add patterns that match:
#   patch_manager_mods/*_src/logs/*.txt, mods678_research/testdata/playlogs/,
#   upstream_prs/*/build*/, research/companion_levelup/logs/live/

# Handoff backup copy (regenerated each /plan-handoff)
.claude/session_handoff.prev.md

# Regenerable review-pipeline output and caches (code under fix/ and verify/ is not ignored)
/.claude/review/fix/raw/
/.claude/review/fix/results/
/.claude/review/fix/reviews/
/.claude/review/fix/checks/
/.claude/review/fix/patches/
/.claude/review/fix/integ/
/.claude/review/fix/judge/
/.claude/review/verify/results/
/.claude/review/verify/raw/
/.claude/review/verify/adj_raw/
/.claude/review/verify/adjudications/
/.claude/review/raw/
/.claude/review/packets/
# work/ is written by the review writers; phaseG/, phaseH/ and phaseH3/ hold hand-written recon notes that handoffs cite
/.claude/review/work/*
!/.claude/review/work/phaseG/
!/.claude/review/work/phaseH/
!/.claude/review/work/phaseH3/
!/.claude/review/work/play1012/
!/.claude/review/work/logfix/
/tests/.cache/
/.claude/contract_baseline.tsv
/.claude/master_ledger_facts.json
/.claude/clef_priors.json
/.claude/router_eval/runs/
/.claude/deep-review/phase3b/l0/out/
/.claude/deep-review/phase3b/replay_src/**/*.out
/.claude/**/*.err
/.claude/waves/

/.claude/subagent_runs/
/.claude/master_ledger*.jsonl
