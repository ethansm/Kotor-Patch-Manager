[metadata]
target_versions = [
    "6A522E71631DCEE93467BD2010F3B23D9145326E1E2E89305F13AB104DBBFFEF",
]

# Replace KotOR 2's final movie blit with Mitchell-Netravali bicubic filtering.
[[hooks]]
address = 0x0040D901
type = "detour"
function = "blitMovieMitchellNetravaliKotor2"
original_bytes = [
    0x50,
    0x8B, 0x8D, 0x20, 0xFF, 0xFF, 0xFF,
    0x8B, 0x51, 0x48,
    0x83, 0xC2, 0x34,
    0x52,
    0x8B, 0x85, 0x20, 0xFF, 0xFF, 0xFF,
    0x8B, 0x48, 0x4C,
    0x51,
    0xFF, 0x15, 0xA0, 0x64, 0x98, 0x00
]
skip_original_bytes = true
exclude_from_restore = []

[[hooks.parameters]]
source = "ebp"
type = "pointer"

[[hooks.parameters]]
source = "eax"
type = "uint"

# Release the movie OpenGL context before KotOR 2 destroys its movie window.
[[hooks]]
address = 0x0040CB20
type = "detour"
function = "releaseMovieFilterKotor2"
original_bytes = [
    0x55,
    0x8B, 0xEC,
    0x81, 0xEC, 0x84, 0x00, 0x00, 0x00
]
exclude_from_restore = []
