+// KotorPatcher exports the target build's SHA-256 as KOTOR_VERSION_SHA before it loads any
+// patch module, so one module can serve both K2 builds without opening addresses.db.
+constexpr char K2_STEAM_SHA[] =
+    "6A522E71631DCEE93467BD2010F3B23D9145326E1E2E89305F13AB104DBBFFEF";
+
+bool IsSteamBuild()
+{
+    char sha[128] = {};
+    const DWORD length = GetEnvironmentVariableA(
+        "KOTOR_VERSION_SHA", sha, sizeof(sha));
+    return length == sizeof(K2_STEAM_SHA) - 1 &&
+        _stricmp(sha, K2_STEAM_SHA) == 0;
+}
+
+// Anything that is not the Steam build keeps the GOG addresses it always used.
+const GameConfig& K2Config()
+{
+    static const GameConfig* config = nullptr;
+    if (!config) {
+        config = IsSteamBuild() ? &K2_STEAM_CONFIG : &K2_GOG_CONFIG;
+    }
+    return *config;
+}
