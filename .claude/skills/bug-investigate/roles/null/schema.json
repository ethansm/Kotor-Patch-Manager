{
  "title": "bug-investigate null-hypothesis output",
  "description": "A verdict on whether the reported symptom is a bug at all, with cited reasons. reasons may be empty here on purpose: the quote checker, not this schema, rejects uncited reasons.",
  "type": "object",
  "required": ["unit_id", "verdict", "reasons"],
  "additionalProperties": false,
  "properties": {
    "unit_id": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["bug", "not_a_bug", "config", "engine_as_designed", "insufficient"]},
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_id", "quote"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string"}
        }
      }
    }
  }
}
