{
 "type": "object",
 "additionalProperties": false,
 "required": ["packet_id", "files_examined", "truncated", "findings", "no_issue_files", "notes"],
 "properties": {
  "packet_id": {"type": "string"},
  "files_examined": {"type": "array", "items": {"type": "string"}},
  "truncated": {"type": "boolean"},
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["local_id", "file", "lines", "commits", "category", "severity", "confidence", "source", "candidate_id", "evidence", "why_it_matters", "suggested_investigation"],
    "properties": {
     "local_id": {"type": "string"},
     "file": {"type": "string"},
     "lines": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?$"},
     "commits": {"type": "array", "items": {"type": "string"}},
     "category": {"type": "string", "enum": ["bug", "memory-safety", "hook", "logic", "test", "build", "api-break", "gate-integrity", "style-risk", "other"]},
     "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
     "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
     "source": {"type": "string", "enum": ["worker", "scanner", "both"]},
     "candidate_id": {"type": ["string", "null"]},
     "evidence": {"type": "string", "minLength": 10},
     "why_it_matters": {"type": "string"},
     "suggested_investigation": {"type": "string"}
    }
   }
  },
  "no_issue_files": {"type": "array", "items": {"type": "string"}},
  "notes": {"type": "string"}
 }
}
